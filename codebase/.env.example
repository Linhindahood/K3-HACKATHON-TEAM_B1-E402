# Discord
DISCORD_BOT_TOKEN=          # token bot từ Discord Developer Portal

# LLM provider đang dùng — chọn 1: openai | gemini | openrouter
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-luna
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=500
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embedding + RAG
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
EVIDENCE_DENSE_THRESHOLD=0.82
GENERATOR_MAX_PASSAGES=3
FAISS_INDEX_DIR=backend/rag/vectorstore

# Backend URL — dùng bởi bot/ và frontend/ để gọi FastAPI
BACKEND_URL=http://localhost:8000
