# Discord
DISCORD_BOT_TOKEN=          # token bot từ Discord Developer Portal

# LLM provider đang dùng — chọn 1: openai | gemini | openrouter
LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embedding + RAG
EMBEDDING_MODEL=text-embedding-3-small
FAISS_INDEX_DIR=backend/rag/vectorstore
SIMILARITY_THRESHOLD=0.55

# Backend URL — dùng bởi bot/ và frontend/ để gọi FastAPI
BACKEND_URL=http://localhost:8000
